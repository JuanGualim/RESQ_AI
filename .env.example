# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

# --- Data: Zetaris (local install; on Windows use Juan's Tailscale IP) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# --- Power: primary provider = Meterless Nightshift ---
# URL and token come from the Nightshift Console.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-token
METERLESS_MODEL=meterless/auto

# --- Model used by smoke_test.py and the agent ---
# Default: Nightshift (same values as above).
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-token
NEMOTRON_MODEL=meterless/auto

# Development only, without Nightshift: direct NVIDIA (never in the demo).
# MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_API_KEY=nvapi-your-key
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: model per lane (both fall back to NEMOTRON_MODEL).
# LANE_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LANE_DEEP_MODEL=

# --- World Model service (to be confirmed with R1) ---
# WORLD_MODEL_URL=http://127.0.0.1:<port>

# --- No-services mode (judges / UI development) ---
SAMPLE_MODE=false
