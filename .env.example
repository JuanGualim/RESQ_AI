# Copia este archivo a .env y pon tus valores reales. Nunca subas .env a GitHub.

# --- Data: Zetaris (instalación local) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=tu-api-key-de-zetaris

# --- Power: proveedor principal = Meterless Nightshift ---
# URL y token salen de la Console de Nightshift.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=tu-token-de-nightshift
METERLESS_MODEL=meterless/auto

# --- Modelo que usa smoke_test.py y el agente ---
# Por defecto: Nightshift (los mismos valores de arriba).
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=tu-token-de-nightshift
NEMOTRON_MODEL=meterless/auto

# Solo para desarrollo en Linux sin Nightshift: NVIDIA directo.
# MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_API_KEY=nvapi-tu-clave
# NEMOTRON_MODEL=id-exacto-del-modelo-nemotron-en-build.nvidia.com
